# dbt Cloud API Configuration
# Copy this file to .env and fill in your values

# Your dbt Cloud API token
DBT_CLOUD_API_TOKEN=your_dbt_cloud_api_token_here

# dbt Cloud instance configuration
DBT_CLOUD_BASE_URL=your_dbt_cloud_base_url_here
DBT_CLOUD_ACCOUNT_ID=your_account_id_here

# Production - Daily Tests job configuration
DBT_CLOUD_JOB_ID=your_job_id_here

# Default output directory (optional)
DBT_CLOUD_ARTIFACTS_DIR=artifacts
